    {
      "id": "t_000111",
      "topic": "health",
      "difficulty": 2,
      "zh": "据统计，经常锻炼的人往往比久坐的人更长寿。",
      "reference": "Statistics show that people who exercise regularly tend to live longer than those who lead a sedentary life.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "statistics show that",
          "zh": "据统计",
          "weight": 2,
          "synonyms": [
            "statistics suggest that"
          ]
        },
        {
          "id": "kp2",
          "head": "tend to",
          "zh": "往往",
          "weight": 2,
          "synonyms": [
            "are likely to"
          ]
        },
        {
          "id": "kp3",
          "head": "live longer",
          "zh": "更长寿",
          "weight": 1
        },
        {
          "id": "kp4",
          "head": "a sedentary life",
          "zh": "久坐的生活",
          "weight": 2,
          "synonyms": [
            "a sedentary lifestyle"
          ]
        }
