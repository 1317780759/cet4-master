        "physical strength"
      ],
      "source": "authored"
    },
    {
      "id": "t_000108",
      "topic": "health",
      "difficulty": 3,
      "zh": "由于缺乏锻炼，越来越多的年轻人患上了颈椎病。",
      "reference": "Due to a lack of exercise, an increasing number of young people are suffering from neck problems.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "due to",
          "zh": "由于",
          "weight": 2,
          "synonyms": [
            "because of",
            "owing to"
          ]
        },
        {
          "id": "kp2",
          "head": "a lack of",
          "zh": "缺乏",
          "weight": 2,
          "synonyms": [
            "lack of",
            "the lack of"
          ]
        },
        {
          "id": "kp3",
          "head": "an increasing number of",
          "zh": "越来越多的",
          "weight": 2,
          "synonyms": [
            "more and more"
          ]
        },
        {
          "id": "kp4",
          "head": "suffering from",
          "zh": "患上（遭受）",
          "weight": 1,
          "synonyms": [
            "developing"
