  "items": [
    {
      "id": "t_000101",
      "topic": "health",
      "difficulty": 2,
      "zh": "均衡的饮食和规律的锻炼对保持身体健康至关重要。",
      "reference": "A balanced diet and regular exercise are essential to maintaining good health.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "a balanced diet",
          "zh": "均衡的饮食",
          "weight": 2,
          "synonyms": [
            "balanced diet"
          ]
        },
        {
          "id": "kp2",
          "head": "regular exercise",
          "zh": "规律的锻炼",
          "weight": 2,
          "synonyms": [
            "regular physical exercise",
            "regular workouts"
          ]
        },
        {
          "id": "kp3",
          "head": "are essential to",
          "zh": "对……至关重要",
          "weight": 2,
          "synonyms": [
            "are essential for",
            "are crucial to"
          ]
        },
        {
          "id": "kp4",
          "head": "maintaining good health",
          "zh": "保持身体健康",
          "weight": 1,
          "synonyms": [
            "keeping healthy",
            "staying healthy"
          ]
        }
      ],
      "hints": [
        "得分点：均衡的饮食 / 规律的锻炼 / 对……至关重要 / 保持身体健康",
        "「均衡的」用 balanced；「规律的」用 regular；「锻炼」作不可数名词用 exercise",
        "句型：A balanced diet and regular exercise are essential to doing sth."
      ],
      "topicWords": [
        "balanced diet",
        "regular exercise",
        "health"
      ],
      "source": "authored"
    },
    {
      "id": "t_000102",
      "topic": "health",
      "difficulty": 2,
      "zh": "随着生活水平的提高，人们越来越关注心理健康。",
      "reference": "With the improvement of living standards, people are paying more and more attention to mental health.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "with the improvement of",
          "zh": "随着……的提高",
          "weight": 2,
          "synonyms": [
            "as living standards improve"
          ]
        },
        {
          "id": "kp2",
          "head": "living standards",
          "zh": "生活水平",
          "weight": 2,
          "synonyms": [
            "the standard of living"
          ]
        },
        {
          "id": "kp3",
          "head": "paying more and more attention to",
          "zh": "越来越关注",
          "weight": 2,
          "synonyms": [
            "attaching more and more importance to"
          ]
        },
        {
          "id": "kp4",
          "head": "mental health",
          "zh": "心理健康",
          "weight": 1
        }
      ],
      "hints": [
        "得分点：随着……的提高 / 生活水平 / 越来越关注 / 心理健康",
        "「生活水平」固定为 living standards；「关注」用 pay attention to，注意 to 是介词",
        "句型：With the improvement of …, people are paying more and more attention to …"
      ],
      "topicWords": [
        "living standards",
        "mental health"
      ],
      "source": "authored"
    },
    {
      "id": "t_000103",
      "topic": "health",
      "difficulty": 2,
      "zh": "医生建议他每天至少睡七个小时，以避免过度疲劳。",
      "reference": "The doctor advised him to sleep at least seven hours a day so as to avoid excessive fatigue.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "advised him to",
          "zh": "建议他……",
          "weight": 2,
          "synonyms": [
            "suggested that he",
            "recommended that he"
          ]
        },
        {
          "id": "kp2",
          "head": "at least",
          "zh": "至少",
          "weight": 2,
          "synonyms": [
            "no less than"
          ]
        },
        {
          "id": "kp3",
          "head": "so as to",
          "zh": "以（以便）",
          "weight": 2,
          "synonyms": [
            "in order to",
            "so that he could"
          ]
        },
        {
          "id": "kp4",
          "head": "excessive fatigue",
          "zh": "过度疲劳",
          "weight": 1,
          "synonyms": [
            "extreme tiredness"
          ]
        }
      ],
      "hints": [
        "得分点：建议他…… / 至少 / 以（以便） / 过度疲劳",
        "「建议某人做」用 advise sb. to do，不可用 suggest sb. to do；「疲劳」用 fatigue 较书面",
        "句型：The doctor advised him to … at least … so as to avoid …"
      ],
      "topicWords": [
        "fatigue",
        "sleep"
      ],
      "source": "authored"
    },
    {
      "id": "t_000104",
      "topic": "health",
      "difficulty": 3,
      "zh": "研究表明，长期熬夜会显著增加患心脏病的风险。",
      "reference": "Studies have shown that staying up late over a long period of time can significantly increase the risk of heart disease.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "studies have shown that",
          "zh": "研究表明",
          "weight": 2,
          "synonyms": [
            "research shows that",
            "research has shown that"
          ]
        },
        {
          "id": "kp2",
          "head": "staying up late",
          "zh": "熬夜",
          "weight": 2,
          "synonyms": [
            "staying up"
          ]
        },
        {
          "id": "kp3",
          "head": "increase the risk of",
          "zh": "增加……的风险",
          "weight": 2,
          "synonyms": [
            "raise the risk of"
          ]
        },
        {
          "id": "kp4",
          "head": "heart disease",
          "zh": "心脏病",
          "weight": 1
        }
      ],
      "hints": [
        "得分点：研究表明 / 熬夜 / 增加……的风险 / 心脏病",
        "「熬夜」用动名词短语 staying up late 作主语；「长期」可用 over a long period of time",
        "句型：Studies have shown that … can increase the risk of …"
      ],
      "topicWords": [
        "heart disease",
        "risk"
      ],
      "source": "authored"
    },
    {
      "id": "t_000105",
      "topic": "health",
      "difficulty": 2,
      "zh": "定期体检有助于在早期发现疾病并及时治疗。",
      "reference": "Regular physical examinations help to detect diseases at an early stage and treat them in time.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "regular physical examinations",
          "zh": "定期体检",
          "weight": 2,
          "synonyms": [
            "regular check-ups",
            "regular health check-ups"
          ]
        },
        {
          "id": "kp2",
          "head": "help to",
          "zh": "有助于",
          "weight": 1,
          "synonyms": [
            "are helpful in",
            "contribute to"
          ]
        },
        {
          "id": "kp3",
          "head": "at an early stage",
          "zh": "在早期",
          "weight": 2,
          "synonyms": [
            "in the early stage",
            "early on"
          ]
        },
        {
          "id": "kp4",
          "head": "in time",
          "zh": "及时",
          "weight": 1,
          "synonyms": [
            "timely"
          ]
        }
      ],
      "hints": [
        "得分点：定期体检 / 有助于 / 在早期 / 及时",
        "「体检」可用 physical examination / check-up；「发现（疾病）」用 detect 比 find 更准确",
        "句型：Regular physical examinations help to detect … at an early stage and treat them in time."
      ],
      "topicWords": [
        "physical examination",
        "detect"
      ],
      "source": "authored"
