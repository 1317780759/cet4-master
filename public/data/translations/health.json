          "id": "kp1",
          "head": "traditional chinese medicine",
          "zh": "中医",
          "weight": 2,
          "synonyms": [
            "traditional chinese medical science"
          ]
        },
        {
          "id": "kp2",
          "head": "emphasizes preventing",
          "zh": "强调预防",
          "weight": 2,
          "synonyms": [
            "stresses preventing"
          ]
        },
        {
          "id": "kp3",
          "head": "by adjusting",
          "zh": "通过调节",
          "weight": 2,
          "synonyms": [
            "by regulating"
          ]
        },
        {
          "id": "kp4",
          "head": "diet and lifestyle",
          "zh": "饮食和生活方式",
          "weight": 1
