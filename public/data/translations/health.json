    {
      "id": "t_000107",
      "topic": "health",
      "difficulty": 2,
      "zh": "充足的睡眠不仅能恢复体力，还能提高学习效率。",
      "reference": "Adequate sleep can not only restore physical strength but also improve learning efficiency.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "adequate sleep",
          "zh": "充足的睡眠",
          "weight": 2,
          "synonyms": [
            "enough sleep",
            "sufficient sleep"
          ]
        },
        {
          "id": "kp2",
          "head": "not only",
          "zh": "不仅",
          "weight": 2
        },
        {
          "id": "kp3",
          "head": "but also",
          "zh": "而且（还）",
          "weight": 1
        },
        {
          "id": "kp4",
          "head": "restore physical strength",
          "zh": "恢复体力",
          "weight": 1,
          "synonyms": [
            "recover physical strength"
          ]
        },
        {
          "id": "kp5",
          "head": "learning efficiency",
          "zh": "学习效率",
          "weight": 1,
          "synonyms": [
            "study efficiency"
          ]
