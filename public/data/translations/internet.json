  "items": [
    {
      "id": "t_000221",
      "topic": "internet",
      "difficulty": 2,
      "zh": "互联网的普及改变了人们获取信息的方式。",
      "reference": "The way people obtain information has been changed by the popularity of the internet.",
      "keyPoints": [
        {
          "id": "kp1",
          "head": "the popularity of",
          "zh": "……的普及",
          "weight": 2
        },
        {
          "id": "kp2",
          "head": "the internet",
          "zh": "互联网",
          "weight": 1
        },
        {
          "id": "kp3",
          "head": "has been changed",
          "zh": "改变了",
          "weight": 2
        },
        {
          "id": "kp4",
          "head": "obtain information",
          "zh": "获取信息",
          "synonyms": [
            "get information",
            "access information"
          ],
          "weight": 2
        }
      ],
      "hints": [
        "得分点：……的普及 / 互联网 / 改变了 / 获取信息",
        "「普及」名词用 popularity；「获取」可用 obtain / access，比 get 更书面",
        "句型：The way people … has been changed by the popularity of …."
      ],
      "topicWords": [
        "internet",
        "information",
        "popularity"
      ],
      "source": "authored"
    },
    {
      "id": "t_000222",
      "topic": "internet",
      "difficulty": 2,
      "zh": "网络购物因其便利和低价受到年轻人的青睐。",
