          "weight": 2
        },
        {
          "id": "kp2",
          "head": "popular among",
          "zh": "受到……的青睐",
          "weight": 2
        },
        {
          "id": "kp3",
          "head": "convenience",
          "zh": "便利",
          "weight": 2
        },
        {
          "id": "kp4",
          "head": "low prices",
          "zh": "低价",
          "weight": 1
