          "zh": "保护环境",
          "weight": 2,
          "synonyms": [
            "environmental protection"
          ]
        },
        {
          "id": "kp2",
          "head": "has become",
          "zh": "已成为",
          "weight": 1,
          "synonyms": [
            "has turned into"
          ]
        },
        {
          "id": "kp3",
          "head": "an important issue",
          "zh": "重要议题",
          "weight": 1,
          "synonyms": [
            "a major issue"
          ]
        },
        {
          "id": "kp4",
          "head": "of common concern",
          "zh": "共同关注",
          "weight": 2,
          "synonyms": [
            "of shared concern"
