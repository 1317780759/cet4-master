          "head": "folk arts",
          "zh": "民间艺术",
          "weight": 2
        },
        {
          "id": "kp3",
          "head": "a history of",
          "zh": "……的历史",
          "weight": 2
        },
        {
          "id": "kp4",
          "head": "more than",
          "zh": "超过",
          "synonyms": [
            "over"
