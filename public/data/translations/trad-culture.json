        {
          "id": "kp2",
          "head": "wooden structures",
          "zh": "木结构",
          "weight": 2
        },
        {
          "id": "kp3",
          "head": "attaches great importance to",
          "zh": "重视／注重",
          "weight": 2
        },
        {
          "id": "kp4",
          "head": "symmetry and overall harmony",
          "zh": "对称与整体的和谐",
          "weight": 2
        }
