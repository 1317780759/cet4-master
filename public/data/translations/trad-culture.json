          "zh": "也／而且",
          "weight": 2
        },
        {
          "id": "kp3",
          "head": "martial art",
          "zh": "武术",
          "weight": 1
        },
        {
          "id": "kp4",
          "head": "keeping fit",
          "zh": "健身",
          "synonyms": [
            "staying healthy",
            "keeping healthy"
