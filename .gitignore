# —— 依赖与构建产物 ——
node_modules/
_nm_trash*/
dist/
coverage/
.vite/
*.local

# —— 数据管线：原始数据源绝不入库 ——
scripts/data/raw/
scripts/data/generated/
!scripts/data/raw/.gitkeep
# 抓取过程的临时响应缓存（如 GitHub API 返回），非产物
scripts/data/_*.json
# ↑ raw/ 整目录不入库：外部提供的语料可能受著作权保护，绝不进仓库。
#   **自撰**卷的源放 scripts/data/authored/papers/ —— 该目录入库，保证 `pnpm data:papers` 可重跑。

# —— 构建期生成的数据产物（由 scripts/build-wordbank.ts 产出）——
# 注意：public/data 是运行时 fetch 的静态资源，需要入库部署；
# 仅原始数据源与中间产物被忽略，见上。
!public/data/.gitkeep

# —— 日志 ——
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
logs/
*.log

# —— 会话临时文件 ——
# PowerShell 5.1 不会把stdout 回显到终端，读命令输出必须先
# `| Out-File -Encoding utf8 <path>` 再读文件，于是产生了大量 .t*/.r*/.tmp-* 草稿。
# 全部忽略，避免它们混进 git status 淹没真正的改动。
# ★ 写成无点前缀（`gs*.txt` 而非 `.gs*.txt`）：gitignore 里前导 `.` 是字面字符，
#   `.gs*.txt` 只能匹配 `.gsfoo.txt`，匹配不到实际产生的 `gs.txt` / `gs2.txt`。
#   同理 `.t*.txt` / `.r*.txt` 只覆盖了点开头的草稿，无点的 `t3.txt` 会漏 —— 故一并放宽。
.t*.txt
.r*.txt
gs*.txt
.tmp-*.txt
.git-status.txt
_status.txt
_chk.txt
full-test.txt

# —— 编辑器 / 系统 ——
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
