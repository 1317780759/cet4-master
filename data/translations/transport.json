        {
          "id": "kp1",
          "head": "private cars",
          "zh": "私家车",
          "weight": 2
        },
        {
          "id": "kp2",
          "head": "increasingly popular",
          "zh": "越来越普及",
          "synonyms": [
            "more and more popular"
          ],
          "weight": 2
        },
        {
          "id": "kp3",
          "head": "with the rapid development of",
          "zh": "随着……的快速发展",
          "synonyms": [
            "along with the rapid development of"
          ],
          "weight": 2
        },
        {
          "id": "kp4",
          "head": "the economy",
          "zh": "经济",
          "weight": 1
        }
